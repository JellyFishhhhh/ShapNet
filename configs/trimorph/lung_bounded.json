{
  "manifest": "data/lung_patient_manifest.csv",
  "output_dir": "runs/trimorph_lung_bounded",
  "device": "cpu",
  "seed": 0,
  "split_seed": 2026,
  "val_fraction": 0.2,
  "test_fraction": 0.2,
  "splits_file": null,
  "input_dim": 1024,
  "threads": 1,
  "budget": {
    "initial": 0.15,
    "step": 0.1,
    "maximum": 0.5,
    "ensure_initial_classes": true
  },
  "morphology": {
    "k": 8,
    "per_slide": 128,
    "max_fit": 2048,
    "protocol": "queried_only"
  },
  "model": {
    "hidden_dim": 32,
    "attention_dim": 16,
    "use_morphology": true,
    "use_view_ids": true,
    "use_fusion": true,
    "three_views": true,
    "discriminative_ratio": 0.25,
    "diverse_patches": 32,
    "balanced_patches": 256
  },
  "training": {
    "warmup_epochs": 1,
    "epochs": 1,
    "lr": 0.0002,
    "weight_decay": 1e-05,
    "fused_weight": 1.0,
    "synthetic_weight": 0.5,
    "warm_start": false,
    "external_initialization": null,
    "external_provenance": null
  },
  "synthesis": {
    "enabled": true,
    "per_patient": 1,
    "max_patches": 256,
    "retain_ratio": 0.25,
    "replacement_ratio": 0.5,
    "mode": "matched"
  },
  "acquisition": {
    "strategy": "coverage",
    "alpha": 1.0,
    "eta": 0.25,
    "synthetic_coverage": true,
    "representation_weight": 0.5,
    "sigma": 0.5
  }
}
